# ==================== 自定义提交配置 ====================
# 本文件用于配置 SUSFS 和 SukiSU 仓库的自定义提交
#
# 使用说明:
#   1. 将 custom 设为 true 启用自定义提交功能
#   2. 在对应配置项后填入想要使用的 commit hash
#   3. 留空表示使用该分支的最新提交
#
# 示例:
#   gki-android14-6.1=abc123def456
#   sukisu=def789abc123
#
# ================================================================

# 是否启用自定义提交 (true/false)
# 历史：2026-08-22 曾 pin gki-android16-6.12=8bc0ecb（susfs4ksu 8-19 提交
# c23be8a 的 getname_flags 3 参数调用对 6.12 树失配）；2026-08-29 解除——
# 上游 susfs4ksu 已修复该问题，且新版 ReSukiSU 需要 susfs v2.2.0 的符号
# （susfs_is_current_proc_no_su 等），旧 pin 反而致链接失败（run 33247638680）。
custom=false

# ==================== SUSFS 各分支的 commit hash ====================
# 仅当 custom=true 时生效
gki-android12-5.10=
gki-android13-5.15=
gki-android14-6.1=
gki-android15-6.6=
gki-android16-6.12=

# ==================== SukiSU 的 commit hash ====================
# 仅当 custom=true 且使用 SukiSU 变体时生效
sukisu=
